# Copy this file to .env.production on the Lightsail instance. Never commit
# .env.production or paste its secret values into issues, logs, or screenshots.

POSTGRES_DB=supplier_comparison
POSTGRES_USER=supplier_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=80

TEST_USER_ID=qqfarm-demo-user
POLICY_UPLOAD_MAX_BYTES=5242880
POLICY_UPLOAD_MAX_PDF_PAGES=50
POLICY_UPLOAD_MAX_EXTRACTED_CHARACTERS=200000

# NUS-ISS organiser-provided OpenAI-compatible LLM gateway.
LLM_GATEWAY_API_KEY=replace-with-organiser-gateway-key
SUPPLIER_MODEL_PROVIDER=openai-compatible
SUPPLIER_MODEL_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
SUPPLIER_MODEL_BASE_URL=https://api.softwaresystems.app/v1
SUPPLIER_MODEL_ENVIRONMENT=ORGANIZER
SUPPLIER_MODEL_API_KEY_ENV=LLM_GATEWAY_API_KEY
SUPPLIER_MODEL_TIMEOUT_SECONDS=60
SUPPLIER_MODEL_MAX_ATTEMPTS=3
SUPPLIER_MODEL_ENABLE_THINKING=false
SUPPLIER_MODEL_MAX_TOKENS=8192
SUPPLIER_REQUIREMENT_MODEL_TIMEOUT_SECONDS=120
SUPPLIER_REQUIREMENT_MODEL_MAX_ATTEMPTS=2
SUPPLIER_REQUIREMENT_MODEL_MAX_TOKENS=1024

# Keep these explicit because the base Compose file otherwise defaults their
# credential name to the SiliconFlow key.
SUPPLIER_DECISION_INTENT_MODEL_PROVIDER=openai-compatible
SUPPLIER_DECISION_INTENT_MODEL_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
SUPPLIER_DECISION_INTENT_MODEL_BASE_URL=https://api.softwaresystems.app/v1
SUPPLIER_DECISION_INTENT_MODEL_API_KEY_ENV=LLM_GATEWAY_API_KEY
SUPPLIER_CONVERSATION_MODEL_PROVIDER=openai-compatible
SUPPLIER_CONVERSATION_MODEL_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
SUPPLIER_CONVERSATION_MODEL_BASE_URL=https://api.softwaresystems.app/v1
SUPPLIER_CONVERSATION_MODEL_API_KEY_ENV=LLM_GATEWAY_API_KEY

# Policy retrieval currently uses SiliconFlow embeddings and reranking. The
# organiser gateway should not replace these unless it explicitly supports
# /embeddings and /rerank with compatible models.
QQFARM_SILICONFLOW_API_KEY=replace-with-siliconflow-key
SUPPLIER_EMBEDDING_PROVIDER=siliconflow
SUPPLIER_EMBEDDING_MODEL_ID=BAAI/bge-m3
SUPPLIER_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SUPPLIER_EMBEDDING_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_EMBEDDING_DIMENSION=1024
SUPPLIER_EMBEDDING_TIMEOUT_SECONDS=30
SUPPLIER_EMBEDDING_MAX_ATTEMPTS=2
SUPPLIER_EMBEDDING_BATCH_SIZE=16
SUPPLIER_RERANK_PROVIDER=siliconflow
SUPPLIER_RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
SUPPLIER_RERANK_BASE_URL=https://api.siliconflow.cn/v1
SUPPLIER_RERANK_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_RERANK_TIMEOUT_SECONDS=30
SUPPLIER_RERANK_MAX_ATTEMPTS=2

# Demo PDFs are text based. Leave OCR off unless scanned PDFs are required.
SUPPLIER_PDF_OCR_ENABLED=false
