QQFARM_SILICONFLOW_API_KEY=replace-with-secret

# Local PostgreSQL used by Docker Compose. Change the password outside local development.
POSTGRES_DB=supplier_comparison
POSTGRES_USER=supplier_app
POSTGRES_PASSWORD=supplier_dev_password
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://supplier_app:supplier_dev_password@localhost:5432/supplier_comparison
QUOTE_STORAGE_PATH=.local-data/quotes
POLICY_UPLOAD_STORAGE_PATH=.local-data/policy-uploads
POLICY_UPLOAD_MAX_BYTES=5242880
POLICY_UPLOAD_MAX_PDF_PAGES=50
POLICY_UPLOAD_MAX_EXTRACTED_CHARACTERS=200000
SUPPLIER_POLICY_ROOT=data/policies
TEST_USER_ID=local-test-user

SUPPLIER_MODEL_PROVIDER=siliconflow
SUPPLIER_MODEL_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
SUPPLIER_MODEL_BASE_URL=https://api.siliconflow.cn/v1
SUPPLIER_MODEL_ENVIRONMENT=LOCAL
SUPPLIER_MODEL_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY

# Requirement intake and AI Summary reuse the main OpenAI-compatible model by
# default. Set these only when either workflow needs a separate deployment.
# SUPPLIER_REQUIREMENT_MODEL_MODEL_ID=
# SUPPLIER_REQUIREMENT_MODEL_BASE_URL=
# SUPPLIER_REQUIREMENT_MODEL_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
# SUPPLIER_SUMMARY_MODEL_MODEL_ID=
# SUPPLIER_SUMMARY_MODEL_BASE_URL=
# SUPPLIER_SUMMARY_MODEL_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_MODEL_TIMEOUT_SECONDS=60
SUPPLIER_MODEL_MAX_ATTEMPTS=3
SUPPLIER_MODEL_RETRY_BACKOFF_SECONDS=0.25
SUPPLIER_MODEL_RETRY_JITTER_SECONDS=0.25
SUPPLIER_MODEL_MAX_RETRY_DELAY_SECONDS=30
SUPPLIER_MODEL_ENABLE_THINKING=false
SUPPLIER_MODEL_MAX_TOKENS=8192
# Optional local-only restricted diagnostics. Do not mount this in normal API/log paths.
# SUPPLIER_MODEL_DIAGNOSTIC_ARTIFACT_DIR=/private/operator-only/model-diagnostics

# Week2 policy retrieval. Embedding and rerank use separate configuration
# prefixes while referencing the same local secret environment variable.
SUPPLIER_EMBEDDING_PROVIDER=siliconflow
SUPPLIER_EMBEDDING_MODEL_ID=BAAI/bge-m3
SUPPLIER_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SUPPLIER_EMBEDDING_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_EMBEDDING_DIMENSION=1024
SUPPLIER_EMBEDDING_TIMEOUT_SECONDS=30
SUPPLIER_EMBEDDING_MAX_ATTEMPTS=2
SUPPLIER_EMBEDDING_BATCH_SIZE=16

SUPPLIER_RERANK_PROVIDER=siliconflow
SUPPLIER_RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
SUPPLIER_RERANK_BASE_URL=https://api.siliconflow.cn/v1
SUPPLIER_RERANK_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_RERANK_TIMEOUT_SECONDS=30
SUPPLIER_RERANK_MAX_ATTEMPTS=2

# Policy explanation: only prose, never a decision engine. If MODEL_ID is
# unset, the configured SUPPLIER_MODEL_MODEL_ID is reused; no provider fallback.
# SUPPLIER_EXPLANATION_MODEL_ID=your-authorized-chat-model
SUPPLIER_EXPLANATION_BASE_URL=https://api.siliconflow.cn/v1
SUPPLIER_EXPLANATION_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_EXPLANATION_TIMEOUT_SECONDS=60
SUPPLIER_EXPLANATION_MAX_ATTEMPTS=2
SUPPLIER_EXPLANATION_MAX_TOKENS=4096

# Optional bounded investigation before batch field review. Existing flow stays
# unchanged when disabled; never enables autonomous fact writes or approval.
SUPPLIER_AGENT_ENABLED=false
# If MODEL_ID / BASE_URL / API_KEY_ENV are unset, reuse SUPPLIER_MODEL_*.
# SUPPLIER_AGENT_MODEL_ID=your-authorized-chat-model
# SUPPLIER_AGENT_BASE_URL=https://api.siliconflow.cn/v1
# SUPPLIER_AGENT_API_KEY_ENV=QQFARM_SILICONFLOW_API_KEY
SUPPLIER_AGENT_TIMEOUT_SECONDS=30
SUPPLIER_AGENT_MAX_TOKENS=1024
SUPPLIER_AGENT_MAX_MODEL_CALLS=8
SUPPLIER_AGENT_MAX_TOOL_CALLS=10
SUPPLIER_AGENT_MAX_SECONDS=90
# Graph-wide durable automatic policy retry reservations (0 disables retries).
SUPPLIER_AGENT_POLICY_MAX_RETRIES=2

# V7 page-quality routing. Keep OCR disabled through stage 6 validation.
SUPPLIER_PDF_OCR_ENABLED=false
SUPPLIER_PDF_MIN_NATIVE_CHARS=80
SUPPLIER_PDF_MIN_PRINTABLE_RATIO=0.90
SUPPLIER_PDF_MIN_ALNUM_RATIO=0.50
SUPPLIER_PDF_PRIMARY_IMAGE_AREA_RATIO=0.50
SUPPLIER_PDF_MAX_SOURCES=400
SUPPLIER_PDF_MAX_SOURCE_CHARACTERS=50000

# V7 OCR runtime. Tesseract 5.5.1 with English trained data is the frozen
# stage 3 selection. Paths are deployment-specific and must not contain secrets.
SUPPLIER_PDF_OCR_RENDER_DPI=300
SUPPLIER_PDF_OCR_MAX_PIXELS_PER_PAGE=12000000
SUPPLIER_PDF_OCR_MAX_PIXELS_PER_DOCUMENT=50000000
SUPPLIER_PDF_OCR_PAGE_TIMEOUT_SECONDS=30
SUPPLIER_PDF_OCR_DOCUMENT_TIMEOUT_SECONDS=120
SUPPLIER_PDF_OCR_MAX_CHARACTERS=50000
SUPPLIER_PDF_OCR_MIN_USABLE_CHARACTERS=80
SUPPLIER_PDF_OCR_MIN_PRINTABLE_RATIO=0.90
SUPPLIER_PDF_OCR_MIN_ALNUM_RATIO=0.50
SUPPLIER_PDF_OCR_TESSERACT_BINARY=/path/to/tesseract
SUPPLIER_PDF_OCR_TESSDATA_DIR=/path/to/tessdata
