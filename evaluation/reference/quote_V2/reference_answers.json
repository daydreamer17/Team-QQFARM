  "normalization_decisions": {
    "piece_supply": "An explicit per-piece price, Individual pieces supply form, and 1 piece order increment support price_basis_quantity=1, price_basis_unit=piece, packaging_type=piece, units_per_pack=1, and order_multiple_units=1 as DOCUMENT-origin normalizations.",
    "zero_other_fees": "An explicit None or No other fees statement normalizes to other_fees_status=NOT_APPLICABLE and other_fees_amount=0.00.",
    "missing_shipping": "If no freight or shipping statement exists, both shipping fields remain null with validation_status=MISSING. A later business question may create an UNKNOWN fee state, but the document recognizer must not invent it or a zero amount.",
    "money_format": "Reference amounts use decimal strings with two fractional digits for stable comparison.",
    "supplier_id": "supplier_id is absent from every V2 quote document. It remains null/MISSING in document-recognition answers; managed supplier IDs are shown only as excluded system context.",
    "po_receipt": "Purchase order receipt is not silently normalized to ORDER_DATE. Supplier C start_event remains unresolved until the business meaning is confirmed."
  },
